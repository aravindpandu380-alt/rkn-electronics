<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f3f5f9;color:#172033}
header{background:#10264d;color:white;text-align:center;padding:25px 12px}
header h1{margin:0}
nav{background:#173b70;padding:12px;text-align:center}
nav a{color:white;text-decoration:none;margin:7px;font-weight:bold}
.hero{background:#2469a8;color:white;text-align:center;padding:35px 15px}
.btn{display:inline-block;background:#ffcc33;color:#172033;padding:11px 18px;border-radius:7px;text-decoration:none;font-weight:bold;margin:7px}
.container{max-width:1000px;margin:auto;padding:22px 14px}
h2{text-align:center;color:#173b70}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
.item,.panel{background:white;padding:17px;border-radius:10px;box-shadow:0 2px 8px #0001}
