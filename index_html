.item h3{margin:0;color:#173b70}
label{display:block;font-weight:bold;margin:13px 0 5px}
input,select,textarea{width:100%;padding:12px;border:1px solid #ccd3df;border-radius:7px;font-size:16px}
textarea{min-height:85px}
.checks{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}
.check{background:#f2f5fa;padding:10px;border-radius:7px}
.check input{width:auto;margin-right:8px}
.check label{display:inline;margin:0;font-weight:normal}
button{width:100%;padding:14px;background:#173b70;color:white;border:0;border-radius:7px;font-size:17px;margin-top:18px}
footer{background:#10264d;color:white;text-align:center;padding:20px}
</style>
</head>
