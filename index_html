<section class="container" id="booking">
<h2>TV Complaint Booking</h2>
<div class="panel">
<form id="bookingForm">

<label for="name">మీ పేరు *</label>
<input id="name" name="name" required>

<label for="phone">మొబైల్ నంబర్ *</label>
<input id="phone" name="phone" type="tel" pattern="[0-9]{10}" maxlength="10" required>

<label for="brand">TV Brand</label>
<select id="brand" name="brand">
<option value="">Brand ఎంచుకోండి</option>
<option>Samsung</option><option>LG</option><option>Sony</option>
<option>TCL</option><option>Mi / Xiaomi</option><option>Hisense</option>
<option>Panasonic</option><option>Philips</option><option>Haier</option>
<option>Toshiba</option><option>Acer</option><option>Kodak</option>
<option>Thomson</option><option>Onida</option><option>Sansui</option>
<option>Vu</option><option>iFFALCON</option><option>Other</option>
</select>

<label for="model">TV Size / Model</label>
<input id="model" name="model" placeholder="ఉదా: 43 Inch LED TV">

<label>TV Complaint Type * (ఒకటి లేదా ఎక్కువ ఎంచుకోండి)</label>
<div class="checks">
<div class="check"><input type="checkbox" name="complaints" value="Backlight Complaint" id="c1"><label for="c1">Backlight Complaint</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Power Supply Complaint" id="c2"><label for="c2">Power Supply Complaint</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Indicator Blinking" id="c3"><label for="c3">Indicator Blinking</label></div>
<div class="check"><input type="checkbox" name="complaints" value="No Indicator" id="c4"><label for="c4">No Indicator</label></div>
<div class="check"><input type="checkbox" name="complaints" value="No Power Supply" id="c5"><label for="c5">No Power Supply</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Motherboard Dead Condition" id="c6"><label for="c6">Motherboard Dead Condition</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Display Complaint" id="c7"><label for="c7">Display Complaint</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Display Break Complaint" id="c8"><label for="c8">Display Break Complaint</label></div>
<div class="check"><input type="checkbox" name="complaints" value="Other Problem" id="c9"><label for="c9">Other Problem</label></div>
</div>

<label for="issue">ఇంకా వివరాలు</label>
<textarea id="issue" name="issue" placeholder="TV సమస్య గురించి వివరించండి"></textarea>

<label for="area">మీ గ్రామం *</label>
<select id="area" required>
<option value="">గ్రామం ఎంచుకోండి</option>
<option>Nellipaka</option>
<option>Lakshmipuram</option>
<option>Cherupalli</option>
<option>Kothapalli</option>
<option>Ramachandrapuram</option>
<option>Lachigudem</option>
<option>Bhimavaram</option>
<option>Marayagudem</option>
<option>Bhadrachalam</option>
<option>Sarapaka</option>
</select>

<label for="address">పూర్తి అడ్రస్ *</label>
<textarea id="address" required placeholder="ఇంటి అడ్రస్ / దగ్గరలోని గుర్తు"></textarea>

<button type="submit">Submit Complaint</button>
<p id="message" style="text-align:center;font-weight:bold"></p>
</form>
