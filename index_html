<script>
document.getElementById("bookingForm").addEventListener("submit", async function(e) {
  e.preventDefault();

  const complaints = Array.from(
    document.querySelectorAll('input[name="complaints"]:checked')
  ).map(item => item.value);

  const message = document.getElementById("message");

  if (complaints.length === 0) {
    message.textContent = "దయచేసి TV Complaint ఎంచుకోండి.";
    return;
  }

  const data = {
    name: document.getElementById("name").value.trim(),
    phone: document.getElementById("phone").value.trim(),
    brand: document.getElementById("brand").value,
    model: document.getElementById("model").value.trim(),
    serviceType: "TV Repair",
    issue: complaints.join(", ") + " - " +
      document.getElementById("issue").value.trim(),
    address: document.getElementById("address").value.trim() +
      ", " + document.getElementById("area").value
  };

  message.textContent = "Booking పంపిస్తున్నాము...";

  try {
    const response = await fetch("/api/bookings", {
      method: "POST",
      headers: {"Content-Type":"application/json"},
      body: JSON.stringify(data)
    });

    const result = await response.json();

    if (!response.ok) {
      throw new Error("Booking failed");
    }

    message.textContent = "మీ Complaint విజయవంతంగా పంపబడింది. ధన్యవాదాలు!";
    this.reset();

  } catch (error) {
    message.textContent = "Booking పంపలేకపోయాము. దయచేసి 9100168283 కి కాల్ చేయండి.";
  }
});
</script>

